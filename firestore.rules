rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all (Master Gate)
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth & RBAC primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ansarahammad369@gmail.com" ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "super_admin")
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ["super_admin", "administrator", "admin"]))
      );
    }

    function isEditor() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "editor")
      );
    }

    function isAuthor() {
      return isSignedIn() && (
        isEditor() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "author")
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidInquiry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50;
    }

    // 1. Posts: Public can read published posts; Staff can read/write based on role
    match /posts/{postId} {
      allow get: if isValidId(postId) && (resource.data.status == 'published' || isAuthor());
      allow list: if resource.data.status == 'published' || isAuthor();
      allow create: if isAuthor();
      allow update: if isEditor() || (isAuthor() && resource.data.authorId == request.auth.uid && request.resource.data.status == 'draft');
      allow delete: if isEditor();
    }

    // 2. Pages: Public can read published pages; Administrator can manage
    match /pages/{pageId} {
      allow get: if isValidId(pageId) && (resource.data.isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 3. Services: Public read; Editor or Administrator write
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow create, update, delete: if isEditor();
    }

    // 4. Locations: Public read; Editor or Administrator write
    match /locations/{locationId} {
      allow get: if isValidId(locationId);
      allow list: if true;
      allow create, update, delete: if isEditor();
    }

    // 5. Categories: Public read; Editor or Administrator write
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update, delete: if isEditor();
    }

    // 6. Tags: Public read; Editor or Administrator write
    match /tags/{tagId} {
      allow get: if isValidId(tagId);
      allow list: if true;
      allow create, update, delete: if isEditor();
    }

    // 7. Media: Public read; Staff can upload; Editor or Admin can delete
    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create: if isAuthor();
      allow update, delete: if isEditor();
    }

    // 8. Menus: Public read; Admin write
    match /menus/{menuId} {
      allow get: if isValidId(menuId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 9. Redirects: Public read for routing; Admin write
    match /redirects/{redirectId} {
      allow get: if isValidId(redirectId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 10. Site Settings: Public read; Admin write
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // 11. Customer Inquiries: Public submit; Private read/manage by Editor or Admin
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow get, list, update, delete: if isEditor();
    }

    // 12. Users: Self or Super Admin get; Super Admin list, create, update, delete
    match /users/{userId} {
      allow get: if isValidId(userId) && (request.auth.uid == userId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }

    // 13. Roles: Authenticated staff read; Super Admin manage
    match /roles/{roleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    // 14. Audit Logs: Admin read; Immutable (no update, no delete)
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 15. Admins gate: Self can verify admin doc; Super Admin manage
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isSuperAdmin());
      allow list, create, update, delete: if isSuperAdmin();
    }
  }
}
