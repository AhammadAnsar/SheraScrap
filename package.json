{
  "name": "shera-scrap-haraj",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run preview",
    "build": "node scripts/build-pages.mjs",
    "preview": "node scripts/preview-pages.mjs",
    "start": "npm run preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test:cloudflare": "node tests/cloudflare.test.mjs && node tests/cloudflare.test.mjs --pages",
    "test:pages": "tsx tests/pages.test.ts",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test:browser": "node tests/browser.test.mjs",
    "test": "npm run test:pages && npm run test:browser"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "sanitize-html": "^2.17.7",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.21",
    "domutils": "^4.0.2",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.5",
    "htmlparser2": "^12.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wrangler": "4.145.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
