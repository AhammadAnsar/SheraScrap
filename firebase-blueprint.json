{
  "entities": {
    "posts": {
      "title": "Blog Post",
      "description": "Published and draft blog posts and scrap market guides.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 200 },
        "titleAr": { "type": "string", "maxLength": 300 },
        "titleEn": { "type": "string", "maxLength": 300 },
        "excerptAr": { "type": "string", "maxLength": 1000 },
        "excerptEn": { "type": "string", "maxLength": 1000 },
        "contentAr": { "type": "string" },
        "contentEn": { "type": "string" },
        "category": { "type": "string", "maxLength": 100 },
        "categorySlug": { "type": "string", "maxLength": 100 },
        "tags": { "type": "array" },
        "featuredImage": { "type": "string", "maxLength": 1000 },
        "author": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 50 },
        "publishedAt": { "type": "string", "maxLength": 50 },
        "scheduledFor": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["published", "draft", "scheduled", "archived", "trash"] },
        "isPublished": { "type": "boolean" },
        "views": { "type": "number" },
        "seoTitleAr": { "type": "string", "maxLength": 300 },
        "seoTitleEn": { "type": "string", "maxLength": 300 },
        "seoDescriptionAr": { "type": "string", "maxLength": 500 },
        "seoDescriptionEn": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "slug", "titleAr", "status"]
    },
    "pages": {
      "title": "Custom Page",
      "description": "CMS custom landing pages and static content pages.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 200 },
        "titleAr": { "type": "string", "maxLength": 300 },
        "titleEn": { "type": "string", "maxLength": 300 },
        "contentAr": { "type": "string" },
        "contentEn": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft", "archived", "trash"] },
        "isPublished": { "type": "boolean" },
        "publishedAt": { "type": "string", "maxLength": 50 },
        "seoTitleAr": { "type": "string", "maxLength": 300 },
        "seoTitleEn": { "type": "string", "maxLength": 300 },
        "seoDescriptionAr": { "type": "string", "maxLength": 500 },
        "seoDescriptionEn": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "slug", "titleAr"]
    },
    "services": {
      "title": "Scrap Service",
      "description": "Core commercial scrap and recycling services.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 200 },
        "titleAr": { "type": "string", "maxLength": 300 },
        "titleEn": { "type": "string", "maxLength": 300 },
        "descriptionAr": { "type": "string", "maxLength": 1000 },
        "descriptionEn": { "type": "string", "maxLength": 1000 },
        "iconName": { "type": "string", "maxLength": 100 },
        "featuredImage": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "slug", "titleAr"]
    },
    "locations": {
      "title": "Location Landing Page",
      "description": "City and region specific commercial scrap and equipment pages.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 200 },
        "cityAr": { "type": "string", "maxLength": 100 },
        "cityEn": { "type": "string", "maxLength": 100 },
        "titleAr": { "type": "string", "maxLength": 300 },
        "titleEn": { "type": "string", "maxLength": 300 },
        "metaDescriptionAr": { "type": "string", "maxLength": 500 },
        "metaDescriptionEn": { "type": "string", "maxLength": 500 },
        "contentAr": { "type": "string" },
        "contentEn": { "type": "string" },
        "servicesOfferedAr": { "type": "array" },
        "servicesOfferedEn": { "type": "array" },
        "phone": { "type": "string", "maxLength": 50 },
        "addressAr": { "type": "string", "maxLength": 300 },
        "addressEn": { "type": "string", "maxLength": 300 },
        "isPublished": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "slug", "cityAr", "titleAr", "isPublished"]
    },
    "categories": {
      "title": "Scrap Category",
      "description": "Metal and equipment scrap categories with market rates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 200 },
        "nameAr": { "type": "string", "maxLength": 200 },
        "nameEn": { "type": "string", "maxLength": 200 },
        "descriptionAr": { "type": "string", "maxLength": 1000 },
        "descriptionEn": { "type": "string", "maxLength": 1000 },
        "rateEstimateAr": { "type": "string", "maxLength": 100 },
        "rateEstimateEn": { "type": "string", "maxLength": 100 },
        "iconName": { "type": "string", "maxLength": 100 },
        "featuredImage": { "type": "string", "maxLength": 1000 },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "pointsAr": { "type": "array" },
        "pointsEn": { "type": "array" },
        "isPublished": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "slug", "nameAr"]
    },
    "tags": {
      "title": "Content Tag",
      "description": "Taxonomy tags for posts and scrap topics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameAr": { "type": "string", "maxLength": 100 },
        "nameEn": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "count": { "type": "number" }
      },
      "required": ["id", "slug", "nameAr"]
    },
    "media": {
      "title": "Media Asset",
      "description": "Stored image and media records.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "maxLength": 1000 },
        "fileName": { "type": "string", "maxLength": 200 },
        "altTextAr": { "type": "string", "maxLength": 300 },
        "altTextEn": { "type": "string", "maxLength": 300 },
        "title": { "type": "string", "maxLength": 200 },
        "mimeType": { "type": "string", "maxLength": 100 },
        "fileSize": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "url", "fileName"]
    },
    "menus": {
      "title": "Navigation Menu Item",
      "description": "Header and footer navigation links.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "labelAr": { "type": "string", "maxLength": 100 },
        "labelEn": { "type": "string", "maxLength": 100 },
        "path": { "type": "string", "maxLength": 300 },
        "order": { "type": "number" },
        "isHeader": { "type": "boolean" },
        "isFooter": { "type": "boolean" },
        "openInNewTab": { "type": "boolean" }
      },
      "required": ["id", "labelAr", "path"]
    },
    "redirects": {
      "title": "URL Redirection",
      "description": "Centralized 301 and 302 URL redirects.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fromUrl": { "type": "string", "maxLength": 500 },
        "toUrl": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["301", "302"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "fromUrl", "toUrl", "type", "active"]
    },
    "settings": {
      "title": "Site Settings",
      "description": "Global business configuration, contact info, and site settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "siteTitleAr": { "type": "string", "maxLength": 300 },
        "siteTitleEn": { "type": "string", "maxLength": 300 },
        "siteTaglineAr": { "type": "string", "maxLength": 300 },
        "siteTaglineEn": { "type": "string", "maxLength": 300 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "addressAr": { "type": "string", "maxLength": 300 },
        "addressEn": { "type": "string", "maxLength": 300 },
        "siteUrl": { "type": "string", "maxLength": 300 },
        "sitemapUrl": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "phone", "whatsapp"]
    },
    "users": {
      "title": "Admin User",
      "description": "CMS administrative users and staff accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["super_admin", "administrator", "editor", "author", "viewer"] },
        "avatar": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "username", "role", "email"]
    },
    "roles": {
      "title": "User Role",
      "description": "Role definitions with assigned permission strings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "roleName": { "type": "string", "maxLength": 50 },
        "permissions": { "type": "array" },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "roleName"]
    },
    "inquiries": {
      "title": "Customer Inquiry",
      "description": "Leads, quote requests, and customer contact submissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 200 },
        "materialType": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["new", "contacted", "completed", "cancelled"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "phone"]
    },
    "auditLogs": {
      "title": "Audit Log",
      "description": "System action history and mutation auditing trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "entityType": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 150 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "action", "entityType", "timestamp"]
    },
    "admins": {
      "title": "Admin Role Gate",
      "description": "Designated administrator UIDs for secure RBAC access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["super_admin", "administrator", "editor", "author"] },
        "email": { "type": "string", "maxLength": 150 }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "posts",
      "description": "Collection of blog posts"
    },
    "/pages/{pageId}": {
      "schema": "pages",
      "description": "Collection of static and custom pages"
    },
    "/services/{serviceId}": {
      "schema": "services",
      "description": "Collection of scrap buying services"
    },
    "/locations/{locationId}": {
      "schema": "locations",
      "description": "Collection of regional location landing pages"
    },
    "/categories/{categoryId}": {
      "schema": "categories",
      "description": "Collection of scrap categories"
    },
    "/tags/{tagId}": {
      "schema": "tags",
      "description": "Collection of taxonomy tags"
    },
    "/media/{mediaId}": {
      "schema": "media",
      "description": "Collection of uploaded media assets"
    },
    "/menus/{menuId}": {
      "schema": "menus",
      "description": "Collection of navigation menu items"
    },
    "/redirects/{redirectId}": {
      "schema": "redirects",
      "description": "Collection of URL redirects"
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "Site settings documents"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "Collection of admin users"
    },
    "/roles/{roleId}": {
      "schema": "roles",
      "description": "Collection of RBAC roles"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiries",
      "description": "Customer inquiry records"
    },
    "/auditLogs/{logId}": {
      "schema": "auditLogs",
      "description": "Administrative audit trail logs"
    },
    "/admins/{adminId}": {
      "schema": "admins",
      "description": "Admin authorization documents"
    }
  }
}
