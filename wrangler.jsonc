{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sherascrap",
  "compatibility_date": "2026-09-30",
  "main": "cloudflare/entry.mjs",
  "assets": {
    "directory": "./dist/pages",
    "binding": "ASSETS",
    "run_worker_first": ["/"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
