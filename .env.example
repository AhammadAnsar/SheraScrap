# Never commit a real .env file or put it in the public web root.
PORT=3000
DATA_DIR=./data
UPLOADS_DIR=./public/uploads
# Optional: use a stable random secret to retain preview links across restarts.
# Without it, the application safely generates a process-local random secret.
PREVIEW_SECRET=
# Optional: enables Gemini image analysis; otherwise the estimator uses demo estimates.
GEMINI_API_KEY=
