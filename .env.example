# Local development uses disk unless CMS_STORAGE=firestore. Vercel always uses Firestore.
CMS_STORAGE=firestore
FIREBASE_PROJECT_ID=shera-scrap
FIREBASE_DATABASE_ID=(default)
FIREBASE_STORAGE_BUCKET=shera-scrap.firebasestorage.app
FIREBASE_CMS_COLLECTION=shera_cms_v2
# Choose JSON OR email/private key. Set actual secret values only in ignored .env / Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PREVIEW_SECRET=
CMS_BOOTSTRAP_ADMIN_EMAIL=
GEMINI_API_KEY=
PORT=3000
